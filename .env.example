# Never commit a real .env. Never put Binance API keys here.
# Agent OS MCP uses OAuth in a listed client, not API keys.

# off = never call placeOrder (default, safe for development)
# replay = labeled recorded-live payloads only (the demo path; APPROVE fires spot_newOrder, sent_to_binance:false)
# live = real MCP trade tool via a custom client — NOT the verified path (custom-Node returned HTTP 401 on 2026-09-03); use replay
EXECUTION_MODE=off

HOST=127.0.0.1
PORT=8787

# Optional. The reasoning trader (POST /agent-propose) uses an OpenAI-compatible
# chat/completions endpoint to PROPOSE a trade intent. Guardian still decides.
# Unset -> the agent falls back to a deterministic canned proposal; the demo works either way.
# The Charter compiler is a fixture and never needs an LLM.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Never commit a real .env. Never put Binance API keys here.
# Agent OS MCP uses OAuth in a listed client, not API keys.

# off = never call placeOrder (default, safe for development)
# replay = labeled recorded-live payloads only
# live = real MCP trade tool (requires Day 0 GO-CUSTOM + explicit confirm)
EXECUTION_MODE=off

HOST=127.0.0.1
PORT=8787

# Optional. Demo Charter uses the fixture compiler and does not need this.
# LLM_BASE_URL=
# LLM_API_KEY=
